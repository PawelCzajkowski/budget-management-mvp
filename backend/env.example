# DynamoDB Configuration
DYNAMODB_TABLE_NAME=budget-management-mvp-budgets
DYNAMODB_USER_USAGE_TABLE_NAME=budget-management-mvp-user-usage

# Cognito Configuration
COGNITO_USER_POOL_ID=your-user-pool-id-here

# Lambda Configuration
LAMBDA_EXECUTION_ROLE_ARN=arn:aws:iam::your-account-id:role/lambda-execution-role

# AI Integration
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=your-langsmith-project-name
LANGSMITH_TRACING=true

# Optional: AWS Credentials (if not using AWS CLI profiles)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Note: AWS_REGION is automatically set by AWS Lambda 